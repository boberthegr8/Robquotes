rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Helper to validate Project
    function isValidProject(data) {
      return data.id is string && data.id.size() <= 100
          && data.name is string && data.name.size() <= 200
          && data.rep is string && data.rep.size() <= 100
          && (data.type == 'Residential' || data.type == 'Commercial')
          && data.priority is bool
          && data.receivedAt is string && data.receivedAt.size() <= 100
          && data.dateStr is string && data.dateStr.size() <= 50
          && (!data.keys().hasAny(['completedDateStr']) || data.completedDateStr is string)
          && data.ewp is bool
          && data.trusses is bool
          && data.windows is bool
          && data.sentForQuote is bool
          && (data.status == 'INCOMING' || data.status == 'ESTIMATING' || data.status == 'QUOTING' || data.status == 'COMPLETE')
          && (!data.keys().hasAny(['estimateSentAt']) || data.estimateSentAt is string)
          && (!data.keys().hasAny(['notes']) || data.notes is string);
    }

    // Helper to validate ActivityLog
    function isValidActivityLog(data) {
      return data.id is string && data.id.size() <= 150
          && data.timestamp is string && data.timestamp.size() <= 100
          && data.user is string && data.user.size() <= 100
          && data.projectName is string && data.projectName.size() <= 200
          && data.action is string && data.action.size() <= 100
          && data.details is string && data.details.size() <= 1000
          && data.badgeColor is string && data.badgeColor.size() <= 200;
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create: if isValidId(projectId) && isValidProject(incoming());
      allow update: if isValidId(projectId) && isValidProject(incoming());
      allow delete: if isValidId(projectId);
    }

    match /activityLogs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId) && isValidActivityLog(incoming());
      allow update: if false; // Logs cannot be altered!
      allow delete: if isValidId(logId); // Allow purging unwanted records
    }
  }
}
